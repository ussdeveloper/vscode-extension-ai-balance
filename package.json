{
  "name": "ai-balance",
  "displayName": "AI Balance",
  "description": "Shows DeepSeek and OpenRouter API balance in the status bar",
  "version": "0.11.2",
  "publisher": "sulaco",
  "icon": "icons/deepseek.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiBalance.refresh",
        "title": "AI Balance: Refresh Now"
      },
      {
        "command": "aiBalance.configure",
        "title": "AI Balance: Open Settings"
      },
      {
        "command": "aiBalance.setDeepSeekKey",
        "title": "AI Balance: Set DeepSeek API Key"
      },
      {
        "command": "aiBalance.setOpenRouterKey",
        "title": "AI Balance: Set OpenRouter API Key"
      },
      {
        "command": "aiBalance.clearKeys",
        "title": "AI Balance: Clear All API Keys"
      },
      {
        "command": "aiBalance.openDashboard",
        "title": "AI Balance: Open Usage Dashboard"
      },
      {
        "command": "aiBalance.setSharedCostsPath",
        "title": "AI Balance: Set Shared Costs File (sync)"
      },
      {
        "command": "aiBalance.setDayStartBalance",
        "title": "AI Balance: Set Today's Starting Balance"
      },
      {
        "command": "aiBalance.setWebitcacheToken",
        "title": "AI Balance: Set webitcache Token (masked)"
      },
      {
        "command": "aiBalance.resetWebitcacheToken",
        "title": "AI Balance: Restore Default webitcache Token"
      }
    ],
    "configuration": {
      "title": "AI Balance",
      "properties": {
        "aiBalance.providers.deepseek.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show DeepSeek balance in status bar"
        },
        "aiBalance.providers.deepseek.apiUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "DeepSeek API base URL"
        },
        "aiBalance.providers.openrouter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show OpenRouter balance in status bar"
        },
        "aiBalance.providers.openrouter.apiUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api",
          "description": "OpenRouter API base URL"
        },
        "aiBalance.display.currency": {
          "type": "string",
          "default": "USD",
          "enum": ["USD", "EUR", "PLN", "GBP", "JPY", "CAD", "AUD", "CHF", "CNY", "CZK", "DKK", "HUF", "NOK", "SEK"],
          "enumDescriptions": [
            "US Dollar ($)",
            "Euro (€)",
            "Polish Złoty (zł)",
            "British Pound (£)",
            "Japanese Yen (¥)",
            "Canadian Dollar (C$)",
            "Australian Dollar (A$)",
            "Swiss Franc (Fr)",
            "Chinese Yuan (¥)",
            "Czech Koruna (Kč)",
            "Danish Krone (kr)",
            "Hungarian Forint (Ft)",
            "Norwegian Krone (kr)",
            "Swedish Krona (kr)"
          ],
          "description": "Target currency for balance display (uses free open.er-api.com)"
        },
        "aiBalance.display.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show AI Balance in the status bar"
        },
        "aiBalance.display.showDailyCost": {
          "type": "boolean",
          "default": true,
          "description": "Show today's estimated cost in the status bar (balance-snapshot based)"
        },
        "aiBalance.refreshInterval": {
          "type": "number",
          "default": 300,
          "description": "Auto-refresh interval in seconds (0 to disable)"
        },
        "aiBalance.display.color": {
          "type": "string",
          "default": "#D4A017",
          "description": "Text color for the status bar balance display (CSS color or empty for default)"
        },
        "aiBalance.dailyCosts.sharedFilePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a shared JSON file (e.g. in OneDrive/Dropbox) that syncs daily balance baselines across computers using the same API key. Leave empty for local-only tracking."
        },
        "aiBalance.dailyCosts.remoteUrl": {
          "type": "string",
          "default": "https://webitcache.analogbrain.com",
          "description": "webitcache base URL used to share the day-start balance across computers. Leave empty to disable remote sync. The token is stored separately (masked, OS keychain) — use the 'AI Balance: Set webitcache Token' / 'Restore Default webitcache Token' commands."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "package": "vsce package --allow-missing-repository --no-dependencies",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulaco/ai-balance"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^6.0.3"
  }
}
